    {
      "case_id": "V2-070",
      "question": "语言模型为何能够生成工具调用请求，这项能力从哪里来？",
      "category": "paraphrase",
      "split": "dev",
      "group": "T002",
      "variant": "hybrid",
      "expected_sources": [
