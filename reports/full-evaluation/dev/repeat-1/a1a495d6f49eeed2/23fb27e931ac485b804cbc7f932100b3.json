    {
      "case_id": "V2-047",
      "question": "资料明明在长提示里却被忽略，为什么中间位置容易丢失信息？",
      "category": "paraphrase",
      "split": "dev",
      "group": "L023",
      "variant": "hybrid",
      "expected_sources": [
