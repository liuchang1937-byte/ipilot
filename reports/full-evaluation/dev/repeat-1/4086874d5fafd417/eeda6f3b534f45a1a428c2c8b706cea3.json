      "case_id": "V2-026",
      "question": "Transformer中的编码器、解码器和注意力层分别做什么？",
      "category": "paraphrase",
      "split": "dev",
      "group": "L002",
      "variant": "hybrid_reranked",
      "expected_sources": [
