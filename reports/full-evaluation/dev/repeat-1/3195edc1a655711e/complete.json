    {
      "case_id": "V2-018",
      "question": "对话进行一半服务重启，如何恢复任务阶段并防止重复执行？",
      "category": "terminology",
      "split": "dev",
      "group": "A018",
      "variant": "hybrid_reranked",
      "expected_sources": [
