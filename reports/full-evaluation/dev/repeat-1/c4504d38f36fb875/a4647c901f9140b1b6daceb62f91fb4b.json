  "records": [
    {
      "case_id": "V2-059",
      "question": "用户问法太口语化，怎样改写查询且不改变原始需求？",
      "category": "paraphrase",
      "split": "dev",
      "group": "R012",
      "variant": "hybrid_reranked",
      "expected_sources": [
