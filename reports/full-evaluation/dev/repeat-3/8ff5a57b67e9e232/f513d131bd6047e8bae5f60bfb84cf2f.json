        "sections": [
          {
            "question": "MCP中的Host承担什么职责？",
            "kind": "knowledge",
            "answer": "",
            "source_ids": [],
            "insufficient": null,
            "trace": {
              "mode": "hybrid",
              "queries": [
                {
                  "kind": "original",
                  "text": "MCP中的Host承担什么职责?"
                },
                {
                  "kind": "mqe",
                  "text": "MCP中Host承担什么职责"
                },
                {
                  "kind": "mqe",
                  "text": "Model Context Protocol 中 Host 的角色和职责"
                },
                {
                  "kind": "mqe",
                  "text": "MCP Host 与 Client、Server 的分工及职责说明"
                },
                {
                  "kind": "hyde",
                  "text": "在 MCP(Model Context Protocol)中,Host 是承载 LLM 的宿主应用或运行时环境,负责创建和管理 MCP Client,并与多个 MCP Server 建立、维护和终止会话。Host 承担能力协商、协议版本与 session 管理、resources/prompts/tools 发现与调用、上下文聚合与提示构造、工具调用路由、模型输出编排、用户授权与同意管理、权限控制、沙箱隔离、速率限制、审计日志、错误处理与通知转发等职责。Host 不直接替代 Client 与 Server 通信,而是通过 Client 间接协调 MCP 连接,并决定哪些服务器能力可暴露给模型及何时请求用户确认。"
                }
              ],
              "warnings": [],
              "reranked": false,
              "candidate_count": 12,
              "rerank_requested": false,
              "selected_count": 3,
