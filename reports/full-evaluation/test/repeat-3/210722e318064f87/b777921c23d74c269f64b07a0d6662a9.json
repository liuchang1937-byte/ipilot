  "records": [
    {
      "case_id": "V2-031",
      "question": "扩大数据、参数和计算量时能力如何变化，所谓涌现如何解释？",
      "category": "paraphrase",
      "split": "test",
      "group": "L007",
      "variant": "expanded",
      "expected_sources": [
